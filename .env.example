# Copy this file to .env (in the repo root) and fill in your values. Never commit .env.
# The backend reads it through backend/config.py: each variable maps to a Settings field
# of the same name in lower case. Commented-out lines show the default used when unset.

# --- Deploy tooling (scripts/deploy.sh); not read by the backend ---
AWS_ACCOUNT_ID=your_12_digit_account_id
DEFAULT_AWS_REGION=eu-north-1
PROJECT_NAME=twin

# --- OpenRouter ---
# Local development only: on AWS the key is read from SSM (OPENROUTER_API_KEY_PARAM holds its name)
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-5-mini
# One of: minimal, low, medium, high (production uses medium)
# OPENROUTER_REASONING_EFFORT=medium

# --- Telegram ---
# Local development only: on AWS these are read from SSM /twin/telegram/* (the *_PARAM variables)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
TELEGRAM_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# --- Browser origins allowed to call the API (comma-separated) ---
# CORS_ORIGINS=http://localhost:3000

# --- Storage ---
# Conversations and notification counters: local files in the repo's memory/ folder by default,
# S3 on AWS. S3_BUCKET is required when USE_S3=true.
# USE_S3=false
# S3_BUCKET=
# MEMORY_DIR=/absolute/path/to/memory
# Learned Q&A: local files in the repo's knowledge/ folder by default, the knowledge bucket on AWS
# KNOWLEDGE_BUCKET=
# KNOWLEDGE_DIR=/absolute/path/to/knowledge
